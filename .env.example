# Copy to .env and fill in. Do NOT commit the real .env.

# --- Frontend ---
# Used for CORS allow_origins (credentialed requests cannot use "*").
FRONTEND_URL=http://localhost:5173

# --- Session JWT ---
# Generate a long random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_SECONDS=604800

# Set to 1 in production (HTTPS) so the session cookie is Secure.
COOKIE_SECURE=0

# Optional: override the database (defaults to local SQLite).
# DATABASE_URL=sqlite:///./ox_ai.db
