# Copy to .env and fill in. Do NOT commit the real .env.

# --- Google OAuth (from Google Cloud Console > Credentials > OAuth client) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must EXACTLY match an Authorized redirect URI on the OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Frontend ---
# Used for CORS allow_origins and for post-login / post-logout redirects.
FRONTEND_URL=http://localhost:5173

# --- Session JWT ---
# Generate a long random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_SECONDS=604800

# Set to 1 in production (HTTPS) so the session cookie is Secure.
COOKIE_SECURE=0
